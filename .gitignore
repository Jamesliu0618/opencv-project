Debug/
Release/
TestResults/
*.trx

# NuGet
packages/
*.nupkg
project.lock.json
project.fragment.lock.json

# Visual Studio Code
.vscode/

# ReSharper
_ReSharper*/
*.DotSettings

# User-specific files
*.userprefs

# Logs
*.log
debug.log

# Windows
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.py[cod]
env/
venv/
