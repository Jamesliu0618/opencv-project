<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>PCBInspection.Core</AssemblyName>
        <RootNamespace>PCBInspection.Core</RootNamespace>
        <PlatformTarget>x64</PlatformTarget>
        <Prefer32Bit>false</Prefer32Bit>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="OpenCvSharp4" Version="4.8.0.20230708"/>
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.8.0.20230708"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1"/>
    </ItemGroup>

    <!-- Copy native OpenCV runtime files to output (ensure native opencv_world and OpenCvSharpExtern are present) -->
    <Target Name="CopyOpenCvNative" AfterTargets="Build">
        <ItemGroup>
            <OpenCvNativeFiles Include="$(NuGetPackageRoot)opencvsharp4.runtime.win\4.8.0.20230708\runtimes\win-x64\native\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(OpenCvNativeFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true"/>
    </Target>
</Project>